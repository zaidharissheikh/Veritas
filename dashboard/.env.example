# Copy to .env.local (git-ignored) to change a setting. Vite only reads VITE_* variables, and
# everything here ends up in the browser bundle: never put an API key or secret in this file.

# Where the Veritas FastAPI backend runs. Default: http://localhost:8000
VITE_API_URL=http://localhost:8000

# "true" skips the backend and uses the built-in mock (demo account + generated history, every
# score marked "Demo data"). Leave it unset or "false" to talk to the real backend.
VITE_USE_MOCK=false
