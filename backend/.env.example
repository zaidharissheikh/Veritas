# Copy to .env and fill in. .env is git-ignored and must never be committed or shipped in the extension/dashboard.
GEMINI_API_KEY=
YOUTUBE_API_KEY=

# Brevo API key: Restricted access, Transactional email = All, other resources = None.
BREVO_API_KEY=
# Must be a verified sender in your Brevo account.
EMAIL_FROM=
# Address of the dashboard, used in verification links. Use your public HTTPS URL when deployed.
FRONTEND_URL=http://localhost:5173
VERIFICATION_TTL_MINUTES=30
PASSWORD_RESET_TTL_MINUTES=15

# Secret used to sign login tokens (HS256). Use a long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty, a built-in DEV-ONLY secret is used and the server logs a warning at startup.
JWT_SECRET=

# Gemini model chain, tried in this order (comma-separated; default shown). A model that answers
# 429/5xx/404 or times out is skipped for the next model straight away and rests ~60 s before it
# is tried again. Free-tier quotas are per model, so several models keep analyses working.
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.5-flash
# Legacy single-model settings, optional: when set they are tried first, before GEMINI_MODELS.
# GEMINI_MODEL=
# GEMINI_FALLBACK_MODEL=

# Optional overrides (the database defaults to backend/veritas.db)
# DATABASE_URL=sqlite:///C:/path/to/veritas.db
# SEED_DEMO=true
